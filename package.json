{
  "name": "broken-arrow-log-assistant",
  "version": "4.0.1",
  "description": "龙区分类器 - 基于断箭 GameLogs 日志与 BATrace 数据的对局复盘工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron smoke.js",
    "pack": "node scripts/prepare-icon.js && electron-builder --dir --publish never",
    "dist": "node scripts/prepare-icon.js && electron-builder --win --publish never",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js"
  },
  "author": "Zola",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alexanderhyu.dragonclassifier",
    "npmRebuild": false,
    "productName": "龙区分类器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "package.json",
      "build/icon.png",
      "native/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "龙区分类器"
    },
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "LICENSE.txt"
        ]
      }
    ]
  }
}
